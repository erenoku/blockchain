# ==========================================
# BSV AI Swap Configuration
# ==========================================

# Network: 'mainnet' or 'testnet'
BSV_NETWORK=mainnet

# Gateway Port (Default: 3300)
PORT=3300

# Default query price in satoshis (500 sats is ~$0.00025 USD)
DEFAULT_PRICE_SATS=500

# ==========================================
# Provider Configuration (Gemini Pro)
# ==========================================
PROVIDER_NAME=Gemini-Pro-Node-1

# IMPORTANT: Put your Provider's BSV Desktop receiving address here
PROVIDER_BSV_ADDRESS=

# IMPORTANT: Put your Google Gemini Pro API Key here
GEMINI_API_KEY=

# IMPORTANT: Put your OpenAI ChatGPT API Key here (optional if using Gemini only)
OPENAI_API_KEY=

# Model selection (e.g. gpt-4o, gemini-3.5-flash)
GEMINI_MODEL=gemini-1.5-pro
OPENAI_MODEL=gpt-4o

# Provider daemon port (Default: 4001)
PROVIDER_PORT=4001

# Gateway URL for Provider to register with
GATEWAY_URL=http://localhost:3300

# ==========================================
# Multi-user network (gateway)
# ==========================================

# Where the SQLite database (accounts, providers, channels) and hosted channel state live
DATA_DIR=./data

# 32-byte key (64 hex chars) that encrypts provider API keys and channel keys in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a development key is created in DATA_DIR/master.key. Never back it up next to the database.
MASTER_KEY=

# Set to true when the gateway is served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false

# Set to true behind a TLS-terminating reverse proxy (nginx, Caddy, a load balancer)
TRUST_PROXY=false

# Other origins allowed to call the API with cookies (comma-separated). Leave empty for same-origin only.
CORS_ORIGINS=
